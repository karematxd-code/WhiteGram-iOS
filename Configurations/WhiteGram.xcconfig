// WhiteGram-iOS Build Configuration

PRODUCT_NAME = WhiteGram
PRODUCT_BUNDLE_IDENTIFIER = org.whitegram.messenger
MARKETING_VERSION = 0.5.3
CURRENT_PROJECT_VERSION = 530

IPHONEOS_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 5.9
CLANG_ENABLE_MODULES = YES
ENABLE_BITCODE = NO
SWIFT_COMPILATION_MODE = wholemodule
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// Code Signing settings for unsigned IPA generation
CODE_SIGN_IDENTITY = 
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_ENTITLEMENTS = 

// Architecture
ARCHS = arm64
VALID_ARCHS = arm64

// Asset Catalog
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
